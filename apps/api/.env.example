NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tour:tour_local_only@localhost:5432/tour_booking?schema=public
REDIS_URL=redis://localhost:6379
CASH_HOLD_MINUTES=1440
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
SEED_ADMIN_EMAIL=admin@tour.local
SEED_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SEED_PASSWORD
# Optional real AI. Select an available model in your Gemini project.
GEMINI_API_KEY=
GEMINI_MODEL=
# Sandbox merchant credentials. Never place any secret in NEXT_PUBLIC_*.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_URL=https://test-payment.momo.vn/v2/gateway/api/create
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_URL=https://sb-openapi.zalopay.vn/v2/create
# Password reset mail. CONSOLE is development/test only.
PASSWORD_RESET_PEPPER=REPLACE_WITH_RANDOM_64_HEX_RESET
MAIL_PROVIDER=CONSOLE
MAIL_FROM=no-reply@example.com
RESEND_API_KEY=
SENDGRID_API_KEY=

# Server-side AI only. Never expose these through NEXT_PUBLIC_*.
AI_REQUIRED=false
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=

# Optional Supabase Storage for persistent cross-device avatars and tour media.
# Prefer a modern sb_secret_... server key. Legacy service_role remains supported for compatibility.
# Never expose either server key as NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
# Optional separate bucket for tour media. Empty means reuse SUPABASE_AVATAR_BUCKET.
SUPABASE_TOUR_BUCKET=
