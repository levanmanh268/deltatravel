NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public operator/support identity shown to customers.
# Configure these with real values before accepting commercial payments.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# Keep false in production unless you intentionally want to expose sandbox gateways.
NEXT_PUBLIC_SHOW_SANDBOX_PAYMENTS=false
